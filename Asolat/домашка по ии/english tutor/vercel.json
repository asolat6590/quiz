{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/index.js?__pathname=/admin"
    },
    {
      "source": "/admin.html",
      "destination": "/api/index.js?__pathname=/admin.html"
    },
    {
      "source": "/login",
      "destination": "/api/index.js?__pathname=/login"
    },
    {
      "source": "/login.html",
      "destination": "/api/index.js?__pathname=/login.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__pathname=/api/$1"
    }
  ]
}
